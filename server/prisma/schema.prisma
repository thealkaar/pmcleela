generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PmcUser {
  id            String  @id
  email         String  @unique
  anonymousName String  @unique @map("anonymous_name")
  scholarNo     String  @map("scholar_no")
  phone         String?
  data          Json    @db.JsonB
  reelLikes     PmcReelLike[]
  reelReports   PmcReelReport[]
  pushTokens    PmcPushToken[]

  @@index([phone], map: "pmc_users_phone_idx")
  @@map("pmc_users")
}

model PmcReel {
  id        String   @id
  creatorId String?  @map("creator_id")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  data      Json     @db.JsonB
  likes     PmcReelLike[]
  comments  PmcReelComment[]
  reports   PmcReelReport[]

  @@index([createdAt(sort: Desc)], map: "pmc_reels_created_at_idx")
  @@index([creatorId], map: "pmc_reels_creator_id_idx")
  @@map("pmc_reels")
}

model PmcReelLike {
  reelId    String   @map("reel_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reel      PmcReel  @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      PmcUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reelId, userId])
  @@index([userId], map: "pmc_reel_likes_user_id_idx")
  @@map("pmc_reel_likes")
}

model PmcReelComment {
  id        String   @id
  reelId    String   @map("reel_id")
  user      String
  userYear  String   @map("user_year")
  text      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reel      PmcReel  @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@index([reelId, createdAt(sort: Desc)], map: "pmc_reel_comments_reel_id_created_at_idx")
  @@map("pmc_reel_comments")
}

model PmcReelReport {
  id         String   @id
  reelId     String   @map("reel_id")
  reporterId String   @map("reporter_id")
  reason     String
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reel       PmcReel  @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reporter   PmcUser  @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reelId, reporterId])
  @@index([status, createdAt(sort: Desc)], map: "pmc_reel_reports_status_created_at_idx")
  @@map("pmc_reel_reports")
}

model PmcPushToken {
  token     String   @id
  userId    String   @map("user_id")
  platform  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      PmcUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "pmc_push_tokens_user_id_idx")
  @@map("pmc_push_tokens")
}

model PmcAnnouncement {
  id        String   @id
  title     String
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "pmc_announcements_created_at_idx")
  @@map("pmc_announcements")
}

model PmcAppRelease {
  id          String   @id
  versionName String   @map("version_name")
  versionCode Int      @unique @map("version_code")
  notes       String
  storageKey  String   @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("pmc_app_releases")
}
