generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PmcUser {
  id            String  @id
  email         String  @unique
  anonymousName String  @unique @map("anonymous_name")
  leelaUsername String  @unique @map("leela_username")
  scholarNo     String  @map("scholar_no")
  phone         String?
  data          Json    @db.JsonB
  reelLikes     PmcReelLike[]
  reelReports   PmcReelReport[]
  pushTokens    PmcPushToken[]
  reelComments  PmcReelComment[]
  notifications PmcUserNotification[]
  chatReportsSubmitted PmcChatReport[] @relation("PmcChatReportReporter")
  chatReportsReceived  PmcChatReport[] @relation("PmcChatReportReportedUser")

  @@index([phone], map: "pmc_users_phone_idx")
  @@map("pmc_users")
}

model PmcStudentIdentity {
  email     String   @id
  gender    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("pmc_student_identities")
}

model PmcAccountDeletionRequest {
  id          String   @id
  userId      String   @map("user_id")
  email       String
  displayName String   @map("display_name")
  gender      String
  status      String   @default("pending")
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  deleteAfter DateTime @map("delete_after") @db.Timestamptz(6)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([status, deleteAfter], map: "pmc_account_deletion_requests_status_due_idx")
  @@map("pmc_account_deletion_requests")
}

model PmcReel {
  id        String   @id
  creatorId String?  @map("creator_id")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  data      Json     @db.JsonB
  likes     PmcReelLike[]
  comments  PmcReelComment[]
  reports   PmcReelReport[]

  @@index([createdAt(sort: Desc)], map: "pmc_reels_created_at_idx")
  @@index([creatorId], map: "pmc_reels_creator_id_idx")
  @@map("pmc_reels")
}

model PmcReelLike {
  reelId    String   @map("reel_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reel      PmcReel  @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      PmcUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reelId, userId])
  @@index([userId], map: "pmc_reel_likes_user_id_idx")
  @@map("pmc_reel_likes")
}

model PmcReelComment {
  id              String           @id
  reelId          String           @map("reel_id")
  userId          String?          @map("user_id")
  parentCommentId String?          @map("parent_comment_id")
  user            String
  userYear        String           @map("user_year")
  text            String
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  reel            PmcReel          @relation(fields: [reelId], references: [id], onDelete: Cascade)
  author          PmcUser?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent          PmcReelComment?  @relation("PmcCommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         PmcReelComment[] @relation("PmcCommentReplies")

  @@index([reelId, parentCommentId, createdAt(sort: Desc), id(sort: Desc)], map: "pmc_reel_comments_page_idx")
  @@index([userId], map: "pmc_reel_comments_user_id_idx")
  @@map("pmc_reel_comments")
}

model PmcUserNotification {
  id        String   @id
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  reelId    String?  @map("reel_id")
  commentId String?  @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  user      PmcUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "pmc_user_notifications_page_idx")
  @@index([userId, readAt], map: "pmc_user_notifications_unread_idx")
  @@map("pmc_user_notifications")
}

model PmcReelReport {
  id         String   @id
  reelId     String   @map("reel_id")
  reporterId String   @map("reporter_id")
  reason     String
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reel       PmcReel  @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reporter   PmcUser  @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reelId, reporterId])
  @@index([status, createdAt(sort: Desc)], map: "pmc_reel_reports_status_created_at_idx")
  @@map("pmc_reel_reports")
}

model PmcChatReport {
  id             String   @id
  reporterId     String   @map("reporter_id")
  reportedUserId String   @map("reported_user_id")
  reason         String
  blockedUntil   DateTime @map("blocked_until") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reporter       PmcUser  @relation("PmcChatReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   PmcUser  @relation("PmcChatReportReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reporterId, createdAt(sort: Desc)], map: "pmc_chat_reports_reporter_created_at_idx")
  @@index([reportedUserId, createdAt(sort: Desc)], map: "pmc_chat_reports_reported_user_created_at_idx")
  @@map("pmc_chat_reports")
}

model PmcPushToken {
  token     String   @id
  userId    String   @map("user_id")
  platform  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      PmcUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "pmc_push_tokens_user_id_idx")
  @@map("pmc_push_tokens")
}

model PmcAnnouncement {
  id        String   @id
  title     String
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "pmc_announcements_created_at_idx")
  @@map("pmc_announcements")
}

model PmcAppRelease {
  id          String   @id
  versionName String   @map("version_name")
  versionCode Int      @unique @map("version_code")
  notes       String
  storageKey  String   @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("pmc_app_releases")
}

model PmcAppSettings {
  id                   String  @id
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")

  @@map("pmc_app_settings")
}
