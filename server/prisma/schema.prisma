generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PmcUser {
  id            String  @id
  email         String  @unique
  anonymousName String  @unique @map("anonymous_name")
  scholarNo     String  @map("scholar_no")
  phone         String?
  data          Json    @db.JsonB

  @@index([phone], map: "pmc_users_phone_idx")
  @@map("pmc_users")
}

model PmcReel {
  id        String   @id
  creatorId String?  @map("creator_id")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  data      Json     @db.JsonB

  @@index([createdAt(sort: Desc)], map: "pmc_reels_created_at_idx")
  @@index([creatorId], map: "pmc_reels_creator_id_idx")
  @@map("pmc_reels")
}
