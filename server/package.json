{
  "name": "pmc-leela-server",
  "version": "1.0.0",
  "description": "Backend for पी एम सी Leela - MANIT Campus Social App",
  "main": "src/index.js",
  "scripts": {
    "start": "prisma migrate deploy && node src/index.js",
    "dev": "node --watch src/index.js",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.19.3",
    "resend": "^6.32.0",
    "socket.io": "^4.7.5",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "ffmpeg-static@5.3.0": true,
    "prisma@6.19.3": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
