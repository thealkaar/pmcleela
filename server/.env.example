NODE_ENV=development
PORT=5000
MAX_UPLOAD_MB=100
JSON_BODY_LIMIT=10mb

# Supabase shared transaction pooler (application queries; port 6543).
# Add ?pgbouncer=true&sslmode=require. Never commit a real password.
DATABASE_URL=
# Supabase shared session pooler (Prisma migrations; port 5432), with sslmode=require.
DIRECT_URL=

# Optional locally; required for production reel uploads.
B2_BUCKET_NAME=pmcleela
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_SIGNED_URL_TTL_SECONDS=43200
B2_KEY_ID=
B2_APPLICATION_KEY=

# Required for production student email verification.
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=PMC Leela
