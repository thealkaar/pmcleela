NODE_ENV=development
PORT=5000
MAX_UPLOAD_MB=100
MAX_APP_RELEASE_MB=250
JSON_BODY_LIMIT=10mb

# Supabase shared transaction pooler (application queries; port 6543).
# Add ?pgbouncer=true&sslmode=require. Never commit a real password.
DATABASE_URL=
# Supabase shared session pooler (Prisma migrations; port 5432), with sslmode=require.
DIRECT_URL=

# Optional locally; required for production reel uploads.
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_TTL_SECONDS=43200

# PMC Admin App credentials. Configure all three only in the Render dashboard.
PMC_ADMIN_EMAIL=
PMC_ADMIN_PASSWORD=
PMC_ADMIN_SESSION_SECRET=

# Required for production student email verification.
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=PMC Leela
