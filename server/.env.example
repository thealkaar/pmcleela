NODE_ENV=development
PORT=5000
MAX_UPLOAD_MB=100
JSON_BODY_LIMIT=10mb

# Optional: set to use Supabase instead of local JSON during development.
# Use the Supabase Session pooler URI from the Dashboard; never commit a real password.
DATABASE_URL=
# Download the database CA certificate from Supabase Database Settings > SSL Configuration.
SUPABASE_DB_CA=
# Temporary pooler compatibility when the CA certificate is unavailable.
# TLS remains encrypted, but the server certificate is not verified.
SUPABASE_DB_SSL_REJECT_UNAUTHORIZED=false

# Optional locally; required for production reel uploads.
B2_BUCKET_NAME=pmcleela
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_SIGNED_URL_TTL_SECONDS=43200
B2_KEY_ID=
B2_APPLICATION_KEY=

# Required for production student email verification.
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=PMC Leela
