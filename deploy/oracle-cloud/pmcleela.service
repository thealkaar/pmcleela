[Unit]
Description=PMC Leela API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pmcleela
Group=pmcleela
WorkingDirectory=/opt/pmcleela/server
EnvironmentFile=/etc/pmcleela/server.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
